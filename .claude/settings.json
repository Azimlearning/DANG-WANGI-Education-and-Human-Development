{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff check:*)",
      "Bash(uv run pyright:*)",
      "Bash(pnpm -r test:*)",
      "Bash(pnpm -r build:*)",
      "Bash(pnpm -r lint:*)",
      "Bash(pnpm -r typecheck:*)",
      "Bash(pnpm codegen:check:*)",
      "Bash(pnpm --filter kit test:*)",
      "Bash(pnpm --filter web test:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(find:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Write(./.env)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_secrets.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
