# Copy to .env and fill in. Never commit .env.
# These are process settings (the .env file). They are unrelated to the "Environment"
# artifact Synapse generates; see CLAUDE.md "Naming hazards".

# fake (default: no network, no cost) or live (paid: every paid run needs the owner's go)
SYNAPSE_LLM_MODE=fake

# Hard monthly spend ceiling in USD, enforced at the LLM seam before any call is sent.
# Required for live mode; the API refuses to start in live mode without it.
LLM_MONTHLY_CAP_USD=

# Primary provider. Required only for live mode.
ANTHROPIC_API_KEY=

# Optional fallback route.
OPENROUTER_API_KEY=

# Where the web app reaches the API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# The public origin the injected artifact CSP names explicitly.
# (An opaque-origin srcdoc iframe makes 'self' match nothing; see ADR D-06.)
PUBLIC_ORIGIN=http://localhost:3000
