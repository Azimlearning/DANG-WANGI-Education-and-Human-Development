      "type": "string"
    },
    "readouts": {
      "items": {
        "$ref": "#/$defs/ReadoutSpec"
      },
      "maxItems": 4,
      "minItems": 1,
      "title": "Readouts",
      "type": "array"
    },
    "scene": {
      "anyOf": [
        {
          "$ref": "#/$defs/SceneSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "sentences": {
      "items": {
        "maxLength": 240,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 6,
      "title": "Sentences",
      "type": "array"
    },
    "steps": {
      "items": {
        "maxLength": 240,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 8,
      "title": "Steps",
      "type": "array"
    },
    "table": {
      "anyOf": [
        {
          "$ref": "#/$defs/TableSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
