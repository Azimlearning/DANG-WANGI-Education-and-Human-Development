          "type": "string"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/TableColumn"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        }
      },
      "required": [
        "caption",
        "columns"
      ],
      "title": "TableSpec",
      "type": "object"
    }
