    "title": {
      "maxLength": 60,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "topic": {
      "maxLength": 80,
      "pattern": "^[a-z0-9_]+$",
      "title": "Topic",
      "type": "string"
    },
    "worked_solution": {
      "items": {
        "maxLength": 240,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 6,
      "title": "Worked Solution",
      "type": "array"
