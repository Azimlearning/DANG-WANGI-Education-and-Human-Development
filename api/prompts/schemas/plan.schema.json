{
  "$defs": {
    "ConceptCheckSpec": {
      "additionalProperties": false,
      "properties": {
        "correct": {
          "maximum": 3,
          "minimum": 0,
          "title": "Correct",
          "type": "integer"
        },
        "explanation": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "options": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 2,
          "title": "Options",
          "type": "array"
        },
        "question": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "question",
        "options",
        "correct",
        "explanation"
      ],
      "title": "ConceptCheckSpec",
      "type": "object"
    },
    "ConstantSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,23}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "unit": {
          "maxLength": 12,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "id",
        "label",
        "unit",
        "value"
      ],
      "title": "ConstantSpec",
      "type": "object"
    },
    "ControlSpec": {
      "additionalProperties": false,
      "properties": {
        "grid": {
          "maximum": 40,
          "minimum": 1,
          "title": "Grid",
          "type": "integer"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,23}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "max": {
          "title": "Max",
          "type": "number"
        },
        "min": {
          "title": "Min",
          "type": "number"
        },
        "surface": {
          "default": "slider",
          "enum": [
            "slider",
            "masses",
            "valve"
          ],
          "title": "Surface",
          "type": "string"
        },
        "unit": {
          "maxLength": 12,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "id",
        "label",
        "unit",
        "min",
        "max",
        "value",
        "grid"
      ],
      "title": "ControlSpec",
      "type": "object"
    },
    "CustomSlot": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,23}$",
          "title": "Name",
          "type": "string"
        },
        "purpose": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        }
      },
      "required": [
        "name",
        "purpose"
      ],
      "title": "CustomSlot",
      "type": "object"
    },
    "ExperimentCard": {
      "additionalProperties": false,
      "properties": {
        "aim": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Aim",
          "type": "string"
        },
        "apparatus": {
          "items": {
            "maxLength": 60,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Apparatus",
          "type": "array"
        },
        "controlled": {
          "items": {
            "maxLength": 60,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Controlled",
          "type": "array"
        },
        "dependent": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Dependent",
          "type": "string"
        },
        "hypothesis": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Hypothesis",
          "type": "string"
        },
        "independent": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Independent",
          "type": "string"
        }
      },
      "required": [
        "aim",
        "hypothesis",
        "independent",
        "dependent",
        "controlled",
        "apparatus"
      ],
      "title": "ExperimentCard",
      "type": "object"
    },
    "GraphSpec": {
      "additionalProperties": false,
      "properties": {
        "digits": {
          "maximum": 6,
          "minimum": 0,
          "title": "Digits",
          "type": "integer"
        },
        "label": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "source": {
          "pattern": "^[a-z][a-z0-9_]{0,23}$",
          "title": "Source",
          "type": "string"
        },
        "title": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "unit": {
          "maxLength": 12,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "x": {
          "pattern": "^[a-z][a-z0-9_]{0,23}$",
          "title": "X",
          "type": "string"
        }
      },
      "required": [
        "title",
        "x",
        "source",
        "label",
        "unit",
        "digits"
      ],
      "title": "GraphSpec",
      "type": "object"
    },
    "ModelUse": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,23}$",
          "title": "Id",
          "type": "string"
        },
        "inputs": {
          "maxProperties": 8,
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,23}$": {
              "pattern": "^[a-z][a-z0-9_]{0,23}$",
              "type": "string"
            }
          },
          "title": "Inputs",
          "type": "object"
        },
        "model": {
          "maxLength": 40,
          "pattern": "^[a-z]+\\.[a-z_]+$",
          "title": "Model",
          "type": "string"
        },
        "params": {
          "maxProperties": 8,
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,23}$": {
              "type": "number"
            }
          },
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "id",
        "model",
        "params",
        "inputs"
      ],
      "title": "ModelUse",
      "type": "object"
    },
    "PredictSpec": {
      "additionalProperties": false,
      "properties": {
        "choices": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 2,
          "title": "Choices",
          "type": "array"
        },
        "prompt": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "reveal": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Reveal",
          "type": "string"
        }
      },
      "required": [
        "prompt",
        "choices",
        "reveal"
      ],
      "title": "PredictSpec",
      "type": "object"
    },
    "ReadoutSpec": {
      "additionalProperties": false,
      "properties": {
        "convert_to": {
          "anyOf": [
            {
              "maxLength": 12,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Convert To"
        },
        "digits": {
          "maximum": 6,
          "minimum": 0,
          "title": "Digits",
          "type": "integer"
        },
        "label": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "source": {
          "pattern": "^[a-z][a-z0-9_]{0,23}$",
          "title": "Source",
          "type": "string"
        },
        "unit": {
          "maxLength": 12,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "label",
        "unit",
        "digits",
        "source"
      ],
      "title": "ReadoutSpec",
      "type": "object"
    },
    "SceneSpec": {
      "additionalProperties": false,
      "description": "A picture bound to a model's output. It draws the quantity and never prints it.",
      "properties": {
        "endpoint": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,23}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endpoint"
        },
        "full": {
          "exclusiveMinimum": 0,
          "title": "Full",
          "type": "number"
        },
        "kind": {
          "enum": [
            "spring",
            "titration"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "pattern": "^[a-z][a-z0-9_]{0,23}$",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "source",
        "full"
      ],
      "title": "SceneSpec",
      "type": "object"
    },
    "TableColumn": {
      "additionalProperties": false,
      "properties": {
        "digits": {
          "maximum": 6,
          "minimum": 0,
          "title": "Digits",
          "type": "integer"
        },
        "label": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "source": {
          "pattern": "^[a-z][a-z0-9_]{0,23}$",
          "title": "Source",
          "type": "string"
        },
        "unit": {
          "maxLength": 12,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "label",
        "unit",
        "source",
        "digits"
      ],
      "title": "TableColumn",
      "type": "object"
    },
    "TableSpec": {
      "additionalProperties": false,
      "properties": {
        "caption": {
          "maxLength": 60,
          "minLength": 1,
