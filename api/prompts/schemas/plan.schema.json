    "constants": {
      "items": {
        "$ref": "#/$defs/ConstantSpec"
      },
      "maxItems": 4,
      "title": "Constants",
      "type": "array"
    },
    "controls": {
      "items": {
        "$ref": "#/$defs/ControlSpec"
      },
      "maxItems": 4,
      "minItems": 1,
      "title": "Controls",
      "type": "array"
    },
    "custom": {
      "items": {
        "$ref": "#/$defs/CustomSlot"
      },
      "maxItems": 3,
      "title": "Custom",
      "type": "array"
